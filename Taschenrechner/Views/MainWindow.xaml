<Window x:Class="Taschenrechner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:Taschenrechner.ViewModels"
        xmlns:local="clr-namespace:Taschenrechner"
        mc:Ignorable="d"
        Title="Rechner" Height="600" Width="400" Background="Gray"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <Style x:Key="CalculatorButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Background" Value="#F0F0F0" />
            <Setter Property="BorderBrush" Value="#CCCCCC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E0E0E0" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#D0D0D0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DigitButtonStyle" TargetType="Button" BasedOn="{StaticResource CalculatorButtonStyle}">
            <Setter Property="Background" Value="#FFFFFF" />
        </Style>

        <Style x:Key="OperationButtonStyle" TargetType="Button" BasedOn="{StaticResource CalculatorButtonStyle}">
            <Setter Property="Background" Value="#E6E6E6" />
        </Style>

        <Style x:Key="FunctionButtonStyle" TargetType="Button" BasedOn="{StaticResource CalculatorButtonStyle}">
            <Setter Property="Background" Value="#D6E9F8" />
        </Style>

        <Style x:Key="EqualsButtonStyle" TargetType="Button" BasedOn="{StaticResource CalculatorButtonStyle}">
            <Setter Property="Background" Value="#4CAF50" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style x:Key="ClearButtonStyle" TargetType="Button" BasedOn="{StaticResource CalculatorButtonStyle}">
            <Setter Property="Background" Value="#FF5252" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style x:Key="MemoryButtonStyle" TargetType="Button" BasedOn="{StaticResource CalculatorButtonStyle}">
            <Setter Property="Background" Value="#FFD54F" />
        </Style>
    </Window.Resources>

    <Window.DataContext>
        <viewModels:MainViewModel />
    </Window.DataContext>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Info-Button -->
        <Button Grid.Row="0" Content="ℹ Info"
                HorizontalAlignment="Right"
                FontSize="12" Padding="8,2"
                Margin="0,0,0,5"
                Click="InfoButton_Click"
                Style="{StaticResource FunctionButtonStyle}" />

        <!-- Expression Display -->
        <Border Grid.Row="1" BorderBrush="#CCCCCC" BorderThickness="1" Margin="0,0,0,5" CornerRadius="4" Background="AliceBlue">
            <TextBlock Text="{Binding ExpressionText}" 
                      FontSize="14" Padding="10,5" 
                      TextWrapping="Wrap"
                      Height="30"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Right"/>
        </Border>

        <!-- Main Display -->
        <Border Grid.Row="2" BorderBrush="#CCCCCC" BorderThickness="1" Margin="0,0,0,10" CornerRadius="4" Background="AliceBlue">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" 
                         Text="{Binding AngleModeText}" 
                         FontSize="12" 
                         VerticalAlignment="Center" 
                         Margin="10,0" 
                         Foreground="#666666"/>

                <TextBlock Grid.Column="1" 
                         Text="{Binding DisplayText}" 
                         FontSize="24" 
                         FontWeight="Bold" 
                         Padding="10" 
                         TextAlignment="Right"/>
            </Grid>
        </Border>

        <!-- Calculator Buttons -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Memory Buttons Row -->
            <Button Grid.Row="0" Grid.Column="0" Content="MC" 
                    Command="{Binding MemoryClearCommand}" 
                    Style="{StaticResource MemoryButtonStyle}" />
            <Button Grid.Row="0" Grid.Column="1" Content="MR" 
                    Command="{Binding MemoryRecallCommand}" 
                    Style="{StaticResource MemoryButtonStyle}" />
            <Button Grid.Row="0" Grid.Column="2" Content="MS" 
                    Command="{Binding MemoryStoreCommand}" 
                    Style="{StaticResource MemoryButtonStyle}" />
            <Button Grid.Row="0" Grid.Column="3" Content="DEG/RAD" 
                    Command="{Binding ToggleAngleModeCommand}" 
                    Style="{StaticResource FunctionButtonStyle}" />
            <Button Grid.Row="0" Grid.Column="4" Content="C" 
                    Command="{Binding ClearCommand}" 
                    Style="{StaticResource ClearButtonStyle}" />

            <!-- Function Buttons Row 1 -->
            <Button Grid.Row="1" Grid.Column="0" Content="sin" 
                    Command="{Binding SpecialFunctionCommand}" 
                    CommandParameter="sin" 
                    Style="{StaticResource FunctionButtonStyle}" />
            <Button Grid.Row="1" Grid.Column="1" Content="cos" 
                    Command="{Binding SpecialFunctionCommand}" 
                    CommandParameter="cos" 
                    Style="{StaticResource FunctionButtonStyle}" />
            <Button Grid.Row="1" Grid.Column="2" Content="tan" 
                    Command="{Binding SpecialFunctionCommand}" 
                    CommandParameter="tan" 
                    Style="{StaticResource FunctionButtonStyle}" />
            <Button Grid.Row="1" Grid.Column="3" Content="log" 
                    Command="{Binding SpecialFunctionCommand}" 
                    CommandParameter="log10" 
                    Style="{StaticResource FunctionButtonStyle}" />
            <Button Grid.Row="1" Grid.Column="4" Content="ln" 
                    Command="{Binding SpecialFunctionCommand}" 
                    CommandParameter="ln" 
                    Style="{StaticResource FunctionButtonStyle}" />

            <!-- Function Buttons Row 2 -->
            <Button Grid.Row="2" Grid.Column="0" Content="x²" 
                    Command="{Binding SpecialFunctionCommand}" 
                    CommandParameter="x²" 
                    Style="{StaticResource FunctionButtonStyle}" />
            <Button Grid.Row="2" Grid.Column="1" Content="x³" 
                    Command="{Binding SpecialFunctionCommand}" 
                    CommandParameter="x³" 
                    Style="{StaticResource FunctionButtonStyle}" />
            <Button Grid.Row="2" Grid.Column="2" Content="√" 
                    Command="{Binding SpecialFunctionCommand}" 
                    CommandParameter="sqrt" 
                    Style="{StaticResource FunctionButtonStyle}" />
            <Button Grid.Row="2" Grid.Column="3" Content="1/x" 
                    Command="{Binding SpecialFunctionCommand}" 
                    CommandParameter="1/x" 
                    Style="{StaticResource FunctionButtonStyle}" />
            <Button Grid.Row="2" Grid.Column="4" Content="n!" 
                    Command="{Binding SpecialFunctionCommand}" 
                    CommandParameter="n!" 
                    Style="{StaticResource FunctionButtonStyle}" />

            <!-- Number and Operation Buttons -->
            <Button Grid.Row="3" Grid.Column="0" Content="7" 
                    Command="{Binding DigitCommand}" 
                    CommandParameter="7" 
                    Style="{StaticResource DigitButtonStyle}" />
            <Button Grid.Row="3" Grid.Column="1" Content="8" 
                    Command="{Binding DigitCommand}" 
                    CommandParameter="8" 
                    Style="{StaticResource DigitButtonStyle}" />
            <Button Grid.Row="3" Grid.Column="2" Content="9" 
                    Command="{Binding DigitCommand}" 
                    CommandParameter="9" 
                    Style="{StaticResource DigitButtonStyle}" />
            <Button Grid.Row="3" Grid.Column="3" Content="DEL" 
                    Command="{Binding BackspaceCommand}" 
                    Style="{StaticResource OperationButtonStyle}" />
            <Button Grid.Row="3" Grid.Column="4" Content="÷" 
                    Command="{Binding OperationCommand}" 
                    CommandParameter="/" 
                    Style="{StaticResource OperationButtonStyle}" />

            <Button Grid.Row="4" Grid.Column="0" Content="4" 
                    Command="{Binding DigitCommand}" 
                    CommandParameter="4" 
                    Style="{StaticResource DigitButtonStyle}" />
            <Button Grid.Row="4" Grid.Column="1" Content="5" 
                    Command="{Binding DigitCommand}" 
                    CommandParameter="5" 
                    Style="{StaticResource DigitButtonStyle}" />
            <Button Grid.Row="4" Grid.Column="2" Content="6" 
                    Command="{Binding DigitCommand}" 
                    CommandParameter="6" 
                    Style="{StaticResource DigitButtonStyle}" />
            <Button Grid.Row="4" Grid.Column="3" Content="(" 
                    Command="{Binding DigitCommand}" 
                    CommandParameter="(" 
                    Style="{StaticResource OperationButtonStyle}" />
            <Button Grid.Row="4" Grid.Column="4" Content="×" 
                    Command="{Binding OperationCommand}" 
                    CommandParameter="*" 
                    Style="{StaticResource OperationButtonStyle}" />

            <Button Grid.Row="5" Grid.Column="0" Content="1" 
                    Command="{Binding DigitCommand}" 
                    CommandParameter="1" 
                    Style="{StaticResource DigitButtonStyle}" />
            <Button Grid.Row="5" Grid.Column="1" Content="2" 
                    Command="{Binding DigitCommand}" 
                    CommandParameter="2" 
                    Style="{StaticResource DigitButtonStyle}" />
            <Button Grid.Row="5" Grid.Column="2" Content="3" 
                    Command="{Binding DigitCommand}" 
                    CommandParameter="3" 
                    Style="{StaticResource DigitButtonStyle}" />
            <Button Grid.Row="5" Grid.Column="3" Content=")" 
                    Command="{Binding DigitCommand}" 
                    CommandParameter=")" 
                    Style="{StaticResource OperationButtonStyle}" />
            <Button Grid.Row="5" Grid.Column="4" Content="-" 
                    Command="{Binding OperationCommand}" 
                    CommandParameter="-" 
                    Style="{StaticResource OperationButtonStyle}" />

            <Button Grid.Row="6" Grid.Column="0" Content="0" 
                    Command="{Binding DigitCommand}" 
                    CommandParameter="0" 
                    Style="{StaticResource DigitButtonStyle}" />
            <Button Grid.Row="6" Grid.Column="1" Content="." 
                    Command="{Binding DigitCommand}" 
                    CommandParameter="." 
                    Style="{StaticResource DigitButtonStyle}" />
            <Button Grid.Row="6" Grid.Column="2" Content="%" 
                    Command="{Binding SpecialFunctionCommand}" 
                    CommandParameter="%" 
                    Style="{StaticResource OperationButtonStyle}" />
            <Button Grid.Row="6" Grid.Column="3" Content="=" 
                    Command="{Binding EqualsCommand}" 
                    Grid.ColumnSpan="1" 
                    Style="{StaticResource EqualsButtonStyle}" />
            <Button Grid.Row="6" Grid.Column="4" Content="+" 
                    Command="{Binding OperationCommand}" 
                    CommandParameter="+" 
                    Style="{StaticResource OperationButtonStyle}" />
        </Grid>
    </Grid>
</Window>
