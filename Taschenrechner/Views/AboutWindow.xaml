<Window x:Class="Taschenrechner.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Info - Taschenrechner"
        Height="280" Width="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="White">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- App-Name -->
        <TextBlock Grid.Row="0"
                   Text="Taschenrechner"
                   FontSize="24" FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,10" />

        <!-- Version -->
        <TextBlock Grid.Row="1"
                   x:Name="VersionText"
                   FontSize="14"
                   HorizontalAlignment="Center"
                   Foreground="#555555"
                   Margin="0,0,0,5" />

        <!-- Autor -->
        <TextBlock Grid.Row="2"
                   Text="Entwickelt von Kamal Mohamed"
                   FontSize="14"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,5" />

        <!-- Copyright -->
        <TextBlock Grid.Row="3"
                   x:Name="CopyrightText"
                   FontSize="12"
                   HorizontalAlignment="Center"
                   Foreground="#888888"
                   Margin="0,0,0,10" />

        <!-- GitHub-Link -->
        <TextBlock Grid.Row="4"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center">
            <Hyperlink NavigateUri="https://github.com/Kamal-Mohamed-Repos/Taschenrechner"
                       RequestNavigate="Hyperlink_RequestNavigate">
                GitHub Repository
            </Hyperlink>
        </TextBlock>

        <!-- OK-Button -->
        <Button Grid.Row="5"
                Content="OK" Width="80" Height="30"
                HorizontalAlignment="Center"
                Click="OkButton_Click"
                IsDefault="True" />
    </Grid>
</Window>